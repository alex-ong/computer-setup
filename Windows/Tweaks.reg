Windows Registry Editor Version 5.00

; 1. Always show underlined keyboard shortcuts (access keys)
[HKEY_CURRENT_USER\Control Panel\Accessibility\Keyboard Preference]
"On"="1"

; 2. Disable Sticky Keys shortcut (Shift 5 times)
[HKEY_CURRENT_USER\Control Panel\Accessibility\StickyKeys]
"Flags"="506"
"HotkeyActive"="0"
"HotkeySound"="0"

; 3. Taskbar / Start menu alignment
; 0 = left, 1 = center (Windows 11 default)
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarAl"=dword:00000000

; Hide Search box
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
"SearchboxTaskbarMode"=dword:00000000

; Hide Task View button
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowTaskViewButton"=dword:00000000